{
  "protocol_id": "aura-final-evaluation-v1",
  "evaluation_stage": "final_test",
  "dataset": "datasets/test.csv",
  "selection_mode": "offline_matched_coverage",
  "classifier": "frozen_distilbert_argmax",
  "policies": [
    "confidence", "flat", "original_aura", "high_protection",
    "guarded_moderate", "logit_margin", "semantic_gate", "signed_gate", "signed_cost_gate"
  ],
  "target_coverages": [0.5, 0.7, 0.8, 0.9, 1.0],
  "evaluation_scenarios": ["flat", "moderate", "high_protection"],
  "primary": {
    "candidate": "signed_cost_gate",
    "reference": "signed_gate",
    "target_coverage": 0.8,
    "evaluation_scenario": "moderate",
    "metric": "candidate_minus_reference_accepted_cost_per_input",
    "favorable_direction": "negative",
    "interpretation": "incremental value of cost weighting given the same learned lexical gate"
  },
  "uncertainty": {
    "method": "paired_iid_message_percentile_bootstrap_with_reranking",
    "n_resamples": 10000,
    "seed": 42,
    "confidence_level": 0.95,
    "primary_support_rule": "primary interval upper endpoint strictly below zero",
    "secondary_intervals": "pointwise descriptive; no multiplicity-adjusted claims"
  },
  "guard_rule": "confidence > 0.5; do not backfill ineligible messages; add matched-count controls",
  "tie_rule": "ascending original test row ID",
  "budget_rule": "floor using decimal target coverage times sample count",
  "secondary_metrics": [
    "accepted_count", "actual_coverage", "deferred_count", "accepted_errors",
    "accepted_accuracy", "accepted_total_cost", "accepted_cost_per_input", "cost_per_accepted"
  ],
  "empty_acceptance": "accuracy and cost_per_accepted are null; accepted total cost is zero",
  "training_on_test": false,
  "threshold_tuning_on_test_labels": false,
  "operational_safety_guarantee": false,
  "test_exposure_history": "not independently verified; disclose any prior test-guided choices",
  "output_directory": "artifacts/final_evaluation/aura-final-evaluation-v1"
}
